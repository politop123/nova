FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG APP
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/nova ./apps/${APP}

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/nova /nova
COPY infrastructure/postgres/init.sql /schema/init.sql
ENTRYPOINT ["/nova"]
